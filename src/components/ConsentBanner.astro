---
---
<div data-consent hidden class="fixed inset-x-3 bottom-24 z-50 mx-auto max-w-lg rounded-2xl border border-line-strong bg-raised p-5 shadow-[var(--shadow-lift)] lg:bottom-6" role="region" aria-label="Analytics consent">
  <p class="text-sm text-muted">
    We use Google Analytics to understand which pages and vehicles are useful. No personal details are sent. You can change this any time.{' '}
    <a href="/privacy" class="text-gold underline underline-offset-2">Privacy Policy</a>
  </p>
  <div class="mt-4 flex gap-3">
    <button type="button" data-consent-choice="granted" class="btn btn-primary !min-h-11 flex-1">Allow analytics</button>
    <button type="button" data-consent-choice="denied" class="btn btn-secondary !min-h-11 flex-1">Decline</button>
  </div>
</div>
<script>
  const box = document.querySelector<HTMLElement>('[data-consent]');
  let stored: string | null = null;
  try { stored = localStorage.getItem('fm-consent'); } catch {}
  if (box && !stored) box.hidden = false;
  box?.addEventListener('click', (e) => {
    const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-consent-choice]')?.dataset.consentChoice;
    if (!choice) return;
    try { localStorage.setItem('fm-consent', choice); } catch {}
    window.gtag?.('consent', 'update', { analytics_storage: choice });
    box.hidden = true;
  });
</script>
