---
import { ChevronRight } from 'lucide-react';
import type { Crumb } from '@/lib/breadcrumbs';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-subtle">
    {crumbs.map((c, i) => (
      <li class="inline-flex items-center gap-1.5">
        {i > 0 && <ChevronRight size={14} aria-hidden="true" />}
        {i === crumbs.length - 1 ? <span aria-current="page" class="text-muted">{c.label}</span> : <a href={c.href} class="hover:text-gold-hi">{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
