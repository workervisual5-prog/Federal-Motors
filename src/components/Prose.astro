<div class="prose-fm container-site mt-14 max-w-3xl">
  <slot />
</div>
<style is:global>
  .prose-fm h2 { margin-top: 2.75rem; font-size: 1.5rem; }
  .prose-fm h3 { margin-top: 1.75rem; font-size: 1.125rem; }
  .prose-fm p, .prose-fm ul { margin-top: 1rem; color: var(--color-muted); }
  .prose-fm ul { list-style: disc; padding-left: 1.25rem; }
  .prose-fm li + li { margin-top: 0.4rem; }
  .prose-fm li::marker { color: var(--color-gold); }
  .prose-fm a { color: var(--color-gold); text-decoration: underline; text-underline-offset: 3px; }
  .prose-fm strong { color: var(--color-text); }
</style>
