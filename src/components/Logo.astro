---
import { Image } from 'astro:assets';
import badge from '@/assets/brand/federal-motors-badge.png';
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
const px = size === 'lg' ? 64 : 44;
---
<a href="/" class="group inline-flex items-center gap-3 shrink-0" aria-label="Federal Motors — home">
  <Image src={badge} alt="" width={px} height={px} densities={[1, 2, 3]} loading="eager" class="rounded-full transition-transform duration-300 group-hover:rotate-[-6deg]" style={`width:${px}px;height:${px}px`} />
  <span class="leading-none">
    <span class={`block whitespace-nowrap font-display tracking-[0.08em] text-gold-hi ${size === 'lg' ? 'text-2xl' : 'text-[1.05rem] sm:text-lg'}`}>FEDERAL MOTORS</span>
    <span class="mt-1 block text-[0.625rem] font-semibold uppercase tracking-[0.28em] text-subtle">Car Showroom · Karachi</span>
  </span>
</a>
