# Public site URL (no trailing slash). Set after the domain is purchased.
SITE_URL=https://federal-motors.netlify.app

# Search engines may index the site only when this is "true". Keep false until launch approval.
PUBLIC_ALLOW_INDEXING=false

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to keep analytics disabled.
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token (content value only). Optional.
PUBLIC_GSC_VERIFICATION=
