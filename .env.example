# All variables are optional public build settings. Set them in Vercel → Project → Settings → Environment Variables.

# Final site URL (no trailing slash). Until set, Vercel's production URL is used automatically.
SITE_URL=

# Search engines may index the site only when this is "true". Set at launch (once the domain is live).
PUBLIC_ALLOW_INDEXING=false

# Google Analytics 4. Production builds default to G-1MRKTXTK2G. Set to "off" to disable.
PUBLIC_GA4_ID=

# Optional email delivery for forms via a form service (e.g. Formspree or Web3Forms).
# Leave empty to keep WhatsApp mode (forms open WhatsApp with the details filled in).
PUBLIC_FORM_ENDPOINT=
# Only for services that need a public access key in the form (e.g. Web3Forms).
PUBLIC_FORM_ACCESS_KEY=

# Google Search Console HTML-tag verification token (content value only). Optional.
PUBLIC_GSC_VERIFICATION=
